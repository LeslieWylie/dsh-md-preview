{
  "name": "dsh-md-preview",
  "version": "0.1.0",
  "description": "Markdown preview drawer for the DeepSeek Harness web GUI — browse, render, edit, and export to standalone HTML without leaving the session. Zero runtime dependencies.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "LeslieWylie",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeslieWylie/dsh-md-preview.git"
  },
  "bugs": {
    "url": "https://github.com/LeslieWylie/dsh-md-preview/issues"
  },
  "homepage": "https://github.com/LeslieWylie/dsh-md-preview#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node tests/render.test.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "markdown",
    "preview",
    "cordis",
    "web-gui"
  ]
}
